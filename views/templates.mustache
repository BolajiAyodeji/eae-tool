<template id="ds-controls-template">
  <link rel="stylesheet" href="../lib/bootstrap-icons.css">

  <style>
    @import url("./ripple.css");
    @import url("./buttons.css");

    main {
      background-color: var(--the-darker-white);
      border-bottom: solid 1px #d9d9d9;
      color: var(--the-color);
      position: relative;
    }

    main.active {
      background-color: white;
    }

    main.disabled {
      color: #9ca9b5;
    }

    header {
      display: flex;
      justify-content: space-between;

      padding: 0.7em;
      padding-right: 0.4em;

      cursor: pointer;
    }

    [bind=description] {
      display: block;

      padding-bottom: 0.9em;
      margin: auto 1em auto 3.8em;

      color: #a3a3a3;
    }

    [bind=description]:empty {
      padding: 0 !important;
      margin: 0 !important;
    }

    [bind=name] {
      flex: 1;
      display: block;
      margin: auto 0.5em;
      line-height: 1.5em;
    }

    [bind=checkbox] {
      flex: 0;
      display: block;
      margin-bottom: -4px;
      transform: scale(0.6);
    }

    .svg-interval {
      filter: drop-shadow(0px 1px 1px rgba(0, 0, 0, 0.3));
    }

    .ramp {
      font-size: 0.8em;
    }

    .control-option {
      margin-left: 1.5em;
      margin-right: 2.5em;
      margin-bottom: 0.9em;
    }

    .collection {
      font-size: 0.85em;
      margin-bottom: 1em;
      margin-top: 0;
      color: #666;
    }

    select {
      border: none;
      box-sizing: content-box;

      padding: 0.65em;

      width: 100%;

      background-color: white;
    }

    .loading {
      position: absolute;
      display: none;
      background-color: rgba(0,0,0,0.15);
      left: 0;
      top: 0;
      height: 100%;
      width: 100%;
      text-align: left;
      z-index: 1;
    }

    .loading .spinner {
      display: block;
      position: relative;
      top: 4px;
      left: 10px;
      border: 1px solid #333;
      border-radius: 50%;
      border-top: 1px solid white;
      background-color: #D0D0D0;
      animation: spin 2s linear infinite;
      width: 24px;
      height: 24px;
      margin: 0.5em;
    }

    @keyframes spin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }

    buttons {
      visibility: hidden;
      justify-content: flex-end;
    }

    :host(:hover) buttons {
      visibility: visible;
    }

    :host(:not(.active)) buttons [bind=card] {
      display: none;
    }
  </style>

  <main>
    <div class="loading">
      <div class="spinner"></div>
    </div>

    <header ripple>
      <span bind="checkbox"></span>
      <span bind="name"></span>

      <buttons>
        <span bind="card"></span>
        <span bind="info"></span>
      </buttons>
    </header>

    <content>
      <span bind="description"></span>
    </content>
  </main>
</template>

<template id="ds-card-template">
  <style>
    @import url("../lib/bootstrap-icons.css");
    @import url("./buttons.css");

    :host {
      background-color: white;
      display: flex;
      flex-flow: column;

      color: var(--the-gray);
      fill: var(--the-gray);

      line-height: 1.8em;

      border-bottom: solid 1px #d9d9d9;
      border-radius: 5px;
      position: relative;

      margin: 1em;
      filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.3));
    }

    header {
      display: flex;
      flex-flow: row nowrap;
      justify-content: space-between;
      user-select: none;
    }

    main {
      display: flex;
      justify-content: space-between;

      padding: 0.5em;
      color: var(--the-color);
    }

    content {
      flex: 1;
      display: block;
      padding: 0.5em;
    }

    aside {
      background-color: #f6f6f6;
    }

    aside .group {
      border-top: solid 1px #d4d4d4;
      padding: 1em;
    }

    .svg-interval,
    .svg-point,
    .svg-polygon,
    .svg-pie {
      filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3));
    }

    [name=title] {
      flex: 1;
      margin-right: 5px;
    }

    [name=info] svg {
      width: 18px;
      margin-top: -2px;
    }

    [name=unit] {
      display: inline-block;
      font-weight: bold;
      font-size: small;
      color: gray;
    }

    handle {
      display: flex;
      align-items: center;
      justify-content: middle;

      color: #ccc;
      font-size: 1.8em;

      cursor: grab;
      cursor: -webkit-grab;
    }

    .weight-group {
      margin-top: 2em;
    }

    .collection {
      list-style-type: none;
      padding: 0;
      margin: 0;
    }

    .collection div,
    .collection svg {
      display: inline-block;
      vertical-align: middle;
    }

    .collection svg {
      transform: scale(0.7);
      margin-right: 0.7em;
    }

    subheader {
      font-size: 0.9em;
      color: #777;
    }
  </style>

  <main>
    <handle>
      <i class="bi bi-grip-vertical"></i>
    </handle>

    <div style="padding: 0.5em;">
      <header>
        <span bind="name"></span>

        <buttons>
          <span bind-if="controls"
                bind="controls"></span>

          <span bind="close"></span>
        </buttons>
      </header>

      <subheader bind-if="index">
        (<span bind="index"></span>)
      </subheader>

      <span bind="range"></span>
      <span bind="ramp"></span>
      <span bind="legends-list"></span>
    </div>
  </main>

  <aside style="display: none;">
    <div class="group">
      <div style="display: flex;
                  justify-content: space-around;">
        <div bind-if="manual-min">
          Min value <span bind="manual-min"></span>
        </div>

        <div>
          Max value <span bind="manual-max"></span>
        </div>
      </div>

      Importance <span bind="weight"></span>
    </div>

    <div class="group"
         style="display: flex;
                justify-content: space-between;">
      <div style="display: flex;">
        Visibility <span bind="visibility"></span>
      </div>

      <div style="display: flex;">
        Opacity <span bind="opacity"></span>
      </div>
    </div>

    <div class="group"
         style="display: flex;
                justify-content: space-around;">
      <div>
        <span bind="info"></span> About
      </div>

      <div bind-if="list">
        <span bind="list"></span> Table
      </div>
    </div>

    <div bind-if="mutant-options"
         class="group">
      <span bind="mutant-options"></span>
    </div>
  </aside>
</template>

<template id="ramp">
  <div class="ramp-container">
    <style>
      .ramp {
        display: flex;
        font-size: 0.8em;
        flex-flow: row nowrap;
        justify-content: space-between;
        margin: auto 1em;
      }

      .unit-ramp {
        font-weight: bold;
        color: darkgray;
      }
    </style>

    <div class="ramp"></div>
  </div>
</template>

<template id="share-link-modal-content">
  <p>
    Sharing the following link will load the Energy Access Explorer platform in
    the current state: layers and analysis.

    Users might need the necessary permissions to view this snapshot fully.
  </p>

  <div style="display:flex; flex-flow: row nowrap;">
    <input id="share-link-input"
           type="text"
           bind="url"
           disabled
           focus />

    <button type="button"
            id="share-link-copy-button">
      <i class="bi bi-copy"
         bind-listen="click"
         bind-func="copy"></i>
    </button>
  </div>
</template>
