<!DOCTYPE html>

<html>
  <head>
    <meta charset="utf-8">

    <meta name="HandheldFriendly" content="true">
    <meta name="MobileOptimized" content="640">
    <meta name="mobile-web-app-capable" content="yes" />

    <link rel="icon" href="{{> views/base}}/images/EAE Logo_Emblem.svg">

    {{> views/cookie}}

    <script src="./libs.js?v=--TIMESTAMP--"></script>
    <script src="./main.js?v=--TIMESTAMP--"></script>

    <link rel="stylesheet" href="../lib/bootstrap-icons.css">

    <link href="../stylesheets/style.css" rel="stylesheet" />
    <link href="../stylesheets/nav.css" rel="stylesheet" />
    <link href="../stylesheets/thumbnails.css" rel="stylesheet" />

    <link href="./main.css" rel="stylesheet" />

    {{> views/head}}
  </head>

  <body>
    {{> views/nav}}

    <div id="banner">
      <h1>Energy Access Explorer</h1>
    </div>

    <div id="playground">
    </div>

    {{> views/loading}}
  </body>

  <script type="module">
    import flash from '../lib/flash.js';
    import pgrest from '../lib/pgrest.js';

    window.FLASH = new flash();
    window.API = new pgrest(EAE['settings'].database, FLASH);
    window.MOBILE = window.innerWidth < 1152;
  </script>

  {{> views/p-templates}}

  {{> views/env }}

  <script type="module">
    import {init} from './p.js';
    init();
  </script>

  {{> views/gapps}}
</html>
